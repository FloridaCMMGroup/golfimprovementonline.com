{
  "name": "golfimprovementonline-com",
  // FloridaCMMGroup Cloudflare account, so deploys never go to the wrong account.
  "account_id": "1e43c1ed4f1ee94730ce36fccf3d752b",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // The worker runs first on every request so it can send www to the bare domain.
    "run_worker_first": true
  },
  // Custom domains. Cloudflare creates the DNS records for these on deploy.
  "routes": [
    { "pattern": "golfimprovementonline.com", "custom_domain": true },
    { "pattern": "www.golfimprovementonline.com", "custom_domain": true }
  ]
}
